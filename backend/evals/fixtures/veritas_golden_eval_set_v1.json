      "input": {"capability": "veritas.synthesize", "payload": {"question": "How do I fix it when it fails?"}},
      "expected": {
        "status": "COMPLETED",
        "answer_hedges_or_clarifies": true,
        "no_placeholder_sources": true,
        "confidence_disclosed_or_abstains": true
